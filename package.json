{
  "name": "ministr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "bash scripts/check-private-links.sh",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/ui/{strings,saveSlots,saveSlots.test,presentationEffects.test,overlays,overlays.test}.ts\" \"src/ai/cpuSimulation.test.ts\" \"tests/**/*.ts\" \"*.{mjs,ts,json}\" \".github/workflows/*.yml\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
